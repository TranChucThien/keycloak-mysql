# Export-only Dockerfile for Keycloak Custom Token Mapper
# Purpose: Build JAR artifacts and export them using scratch image
# Usage: Extract artifacts for local deployment or volume mounting

FROM maven:3.8.4-openjdk-11-slim AS builder

WORKDIR /app
COPY pom.xml .
COPY src ./src

# Build custom token mapper JAR files
RUN mvn clean package -DskipTests

# Export stage: Minimal scratch image for artifact extraction
FROM scratch AS export
COPY --from=builder /app/target/*.jar /